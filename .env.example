# ── Baserow ────────────────────────────────────────────────────────
BASEROW_URL=http://localhost
BASEROW_TOKEN=your_baserow_database_token
BASEROW_POSTS_TABLE_ID=0

# ── Freepik Upscaler ──────────────────────────────────────────────
FREEPIK_API_KEY=your_freepik_api_key
FREEPIK_SCALE_FACTOR=4
FREEPIK_SHARPEN=7
FREEPIK_SMART_GRAIN=7
FREEPIK_ULTRA_DETAIL=30

# ── OpenRouter (Gemini image generation) ──────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3-pro-image-preview

# ── ImgBB (image hosting) ─────────────────────────────────────────
IMGBB_API_KEY=your_imgbb_api_key

# ── Kie.ai (video generation) ─────────────────────────────────────
KIEAI_API_KEY=your_kieai_api_key
KIEAI_MODEL=kling-2.6/image-to-video
KIEAI_VIDEO_DURATION=10

# ── App Settings ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# ── Production Settings ───────────────────────────────────────────
MAX_RETRIES=5
MAX_CONCURRENT_ROWS=3
